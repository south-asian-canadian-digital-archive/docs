---
// Overrides Starlight's SocialIcons slot to add plain top-level links next to
// the theme toggle. Starlight has no config option for these, only social
// icons. GitHub stays the icon Starlight renders from `social`.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const links = [
  { label: 'Archive', href: 'https://sacda.ufv.ca/' },
  { label: 'llms.txt', href: `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}llms.txt` },
];
---

<div class="doc-nav">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
</div>
<Default><slot /></Default>

<style>
  .doc-nav {
    display: none;
    gap: 1.15rem;
    align-items: center;
    font-size: 0.83rem;
    color: var(--sl-color-gray-2);
  }

  .doc-nav a {
    color: inherit;
    text-decoration: none;
  }

  .doc-nav a:hover {
    color: var(--sl-color-white);
  }

  @media (min-width: 50rem) {
    .doc-nav {
      display: flex;
    }
  }
</style>
