---
// Overrides Starlight's SiteTitle: the mark, the wordmark and a `docs` badge.
// Links to the docs index, which is otherwise unreachable once you follow a link
// into the tree.
import Logo from './Logo.astro';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<a href={home} class="site-title sl-flex">
  <Logo size={19} />
  <span translate="no">SACDA</span>
  <span class="doc-badge">docs</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 9px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .doc-badge {
    font-family: var(--sl-font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-hairline);
    padding: 0.2em 0.4em;
  }
</style>
