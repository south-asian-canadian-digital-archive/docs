---
// A neutral mark: a square tile with three stacked rules, read as shelved
// records. Colours come from --logo-tile and --logo-mark in sacda-docs.css, so
// it inverts with the theme.
const { size = 19 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  class="doc-mark"
  aria-hidden="true"
>
  <rect width="24" height="24" fill="var(--logo-tile)"></rect>
  <rect x="5" y="6" width="14" height="2.4" fill="var(--logo-mark)"></rect>
  <rect x="5" y="10.8" width="14" height="2.4" fill="var(--logo-mark)"></rect>
  <rect x="5" y="15.6" width="9" height="2.4" fill="var(--logo-mark)"></rect>
</svg>

<style>
  .doc-mark {
    display: block;
    flex: none;
  }
</style>
