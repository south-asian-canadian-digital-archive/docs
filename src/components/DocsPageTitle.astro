---
// Overrides Starlight's PageTitle to put the markdown/assistant control on the
// title line. PageTitle is the only override that sits inside the content
// column above the prose, which is where this control belongs.
import MarkdownActions from './MarkdownActions.astro';
import { tagLabel } from '../tags';

const { title } = Astro.locals.starlightRoute.entry.data;
const tags: string[] = (Astro.locals.starlightRoute.entry.data as { tags?: string[] }).tags ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="doc-title-row">
  <h1 id="_top">{title}</h1>
  <MarkdownActions />
</div>
{tags.length > 0 && (
  <ul class="doc-tags" aria-label="Tags">
    {tags.map((t) => <li><a class="doc-tag" href={`${base}/tags/${t}/`}>{tagLabel(t)}</a></li>)}
  </ul>
)}

<style>
  .doc-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  h1 {
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    margin: 0;
    text-wrap: balance;
  }

  .doc-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .doc-tags li { margin: 0; }

  /* The control drops under the title before it would squeeze it. */
  @media (max-width: 30rem) {
    .doc-title-row {
      flex-direction: column;
      gap: 0.9rem;
    }
  }
</style>
